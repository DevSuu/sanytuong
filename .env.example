# ==============================================================
# UTT Innovation Portal — Environment Configuration Template
# Instructions:
#   1. Copy this file to .env: `cp .env.example .env`
#   2. Fill in real production credentials in .env
#   3. NEVER commit .env to version control!
# ==============================================================

# --------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# --------------------------------------------------------------
POSTGRES_USER=utt
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=utt_innovation

# In Docker stack (docker-compose.yml), services access postgres via service name:
# DATABASE_URL=postgresql://utt:replace_with_strong_database_password@postgres:5432/utt_innovation
# For local host development without Docker:
DATABASE_URL=postgresql://utt:replace_with_strong_database_password@localhost:5432/utt_innovation

# --------------------------------------------------------------
# 2. Application & Domain URLs
# --------------------------------------------------------------
APP_ENV=production
# Official domain configured by Server IT / Reverse Proxy (Nginx, Caddy, IIS, etc.)
APP_URL=https://sanytuong.utt.edu.vn
PUBLIC_APP_URL=https://sanytuong.utt.edu.vn

# --------------------------------------------------------------
# 3. Authentication & Security (Better Auth & AES Cryptography)
# --------------------------------------------------------------
BETTER_AUTH_URL=https://sanytuong.utt.edu.vn
BETTER_AUTH_TRUSTED_ORIGINS=https://sanytuong.utt.edu.vn,http://localhost:3000,http://127.0.0.1:3000
# Minimum 32-character high-entropy secret string for Better Auth session signing
BETTER_AUTH_SECRET=replace_with_32_plus_char_random_secret_for_better_auth

# Optional 32-byte (64 hex characters) encryption key for AES-256-GCM lookup token encryption.
# If left empty, system automatically derives an AES key from BETTER_AUTH_SECRET.
LOOKUP_TOKEN_ENCRYPTION_KEY=

# --------------------------------------------------------------
# 4. Cloudflare Tunnel (Optional — only if using --profile cloudflare)
# --------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------
# 5. Email System (Gmail SMTP & Outbox Worker)
# --------------------------------------------------------------
# Delivery Mode: 'smtp' (production Gmail SMTP dispatch) or 'console' (local sink, no physical delivery)
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=i4t@utt.edu.vn
# Google Workspace / Gmail App Password (16 characters, format: xxxx xxxx xxxx xxxx)
SMTP_PASSWORD=replace_with_gmail_app_password
EMAIL_FROM=i4t@utt.edu.vn

# Local / Test redirection safeguards (MUST be disabled in genuine production)
# In genuine production (NODE_ENV=production + non-localhost APP_URL), EMAIL_REDIRECT_ALL is strictly rejected
EMAIL_REDIRECT_ALL=false
EMAIL_TEST_RECIPIENT=anhvh@utt.edu.vn
TEST_EMAIL_RECIPIENT=anhvh@utt.edu.vn

# --------------------------------------------------------------
# 6. Initial Seed / CLI Administration (Optional)
# --------------------------------------------------------------
DEV_ADMIN_EMAIL=admin@localhost
DEV_ADMIN_PASSWORD=admin
